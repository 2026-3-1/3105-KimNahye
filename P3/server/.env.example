# 서버 환경 설정
# 개발: dev / 운영: prod
NODE_ENV=

# 데이터베이스 설정
# 형식: postgresql://{유저명}:{비밀번호}@{호스트}:{포트}/{DB명}
DATABASE_URL=postgresql://

# JWT 설정
# openssl rand -base64 32 로 생성 권장
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# JWT 리프레시 토큰 만료 시간 (예: 7d, 30d)
JWT_REFRESH_TOKEN_EXPIRES_IN=

# 클라이언트 URL (CORS origin 제한 — 프로덕션 도메인 지정 필수)
CLIENT_URL=http://localhost:5173

# Redis 캐시 (docker-compose 사용 시: redis://redis:6379)
REDIS_URL=redis://localhost:6379

# 이메일 발송 (Nodemailer SMTP)
# Gmail 사용 시: 구글 계정 → 보안 → 앱 비밀번호 생성 후 SMTP_PASS에 입력
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SolvingMeal <noreply@solvingmeal.com>"

# 토스페이먼츠 결제
# 대시보드: https://developers.tosspayments.com
# 테스트 키는 test_ 접두사, 실키는 live_ 접두사
TOSS_SECRET_KEY=
# Webhook 시크릿: 토스 대시보드 Webhook 탭에서 발급
TOSS_WEBHOOK_SECRET=

# 프론트엔드용 환경변수는 client/.env 파일에 별도 설정
# VITE_TOSS_CLIENT_KEY=test_ck_...
# VITE_API_URL=http://localhost:8080/api/v1

